<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>AGXDeviceUserClient</string>
		<string>IOHDIXControllerUserClient</string>
		<string>IOSurfaceRootUserClient</string>
	</array>
	<!--
	  The in-process wallpaper route (Drift/Core/PosterBoardLocal.swift) needs
	  this group: worse_query stages its symlink inside the group's
	  Library/Caches and asks containermanagerd to resolve it.

	  This is Drift's declared default group. At runtime the app reads the
	  effective process application-groups entitlement and falls back to the
	  signed Mach-O entitlements when SecTask returns no value, matching
	  Erosion-CN. SideStore / Personal Team signing is not rejected by label:
	  the selected group must still resolve to a usable container.
	  The final signed entitlement and container check remain decisive.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sociart.drift</string>
	</array>
</dict>
</plist>
