        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体"
          }
        }
      }
    },
    "Mercury": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态壁纸"
          }
        }
      }
    },
    "Pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "PosterBoard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PosterBoard"
          }
        }
      }
    },
    "Ready: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪：%@"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Ships the wallpaper store's whole contents, database included — the kind most likely to scramble your existing wallpapers. Only for packs that actually are containers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ships the wallpaper store's whole contents, database included — the kind most likely to scramble your existing wallpapers. Only for packs that actually are containers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把整个壁纸商店的内容整包刷入，带着数据库，最容易弄乱现有壁纸。不是容器包就别选它。"
          }
        }
      }
    },
    "Slide %lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Slide %1$lld of %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 张幻灯片，共 %2$lld 张"
          }
        }
      }
    },
    "Suggested Photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片推荐"
          }
        }
      }
    },
    "Templates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板"
          }
        }
      }
    },
    "This device is on iOS %@, which reads a legacy pack as it is, so nothing is converted here and no pack is asked about.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备运行的是 iOS %@，它会按原样读取旧版包，因此这里不会做任何转换，也不会询问任何包。"
          }
        }
      }
    },
    "Tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道"
          }
        }
      }
    },
    "iOS 27's wallpaper library cannot read this legacy (WWDC22) layout at all: installed as-is, the wallpaper would never appear — no error, just nothing. Converting rewrites the pack into the modern layout iOS 27 reads. Pick “Install as is” to push the original files untouched instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27 的壁纸库完全读不了这种（WWDC22）老布局：按原样刷进去不会报错，也永远不会显示。转换会把包改写成 iOS 27 能读的新布局。选择“按原样安装”则可以原封不动地推送原始文件。"
          }
        }
      }
    },
    "tunnel: %@ · peer %@:%u reachable: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "tunnel: %1$@ · peer %2$@:%3$u reachable: %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道：%1$@ · 对端 %2$@:%3$u 可达：%4$@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
