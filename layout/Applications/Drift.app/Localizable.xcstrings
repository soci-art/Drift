{
  "sourceLanguage": "en",
  "strings": {
    "%@ uses the legacy %@ format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses the legacy %2$@ format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用旧版 %2$@ 格式。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件"
          }
        }
      }
    },
    "AFC media": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AFC 媒体"
          }
        }
      }
    },
    "AirLift": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirLift"
          }
        }
      }
    },
    "App Container": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器"
          }
        }
      }
    },
    "Appears in the gallery section that suggests wallpapers made from your own photo library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears in the gallery section that suggests wallpapers made from your own photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现在壁纸库里拿你相册照片做壁纸的推荐栏。"
          }
        }
      }
    },
    "Appears in the wallpaper gallery's Collections section, alongside Apple's own featured wallpapers. Right for most packs — and the safe pick when unsure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears in the wallpaper gallery's Collections section, alongside Apple's own featured wallpapers. Right for most packs — and the safe pick when unsure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现在壁纸库的「合集」栏，和系统自带的精选壁纸排在一起。大多数包选这个，拿不准也选这个。"
          }
        }
      }
    },
    "Apple's dynamic wallpapers — the kind with floating layers and depth motion. Older WWDC22-format packs are usually this kind.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's dynamic wallpapers — the kind with floating layers and depth motion. Older WWDC22-format packs are usually this kind."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统动态壁纸那一类，带漂浮图层和景深动效。WWDC22 那种老格式包多半是这类。"
          }
        }
      }
    },
    "Apply %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用 %@"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对"
          }
        }
      }
    },
    "Clears the Collections and MercuryPoster descriptor folders.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除合集与动态壁纸的描述文件文件夹。"
          }
        }
      }
    },
    "Clears the Photos poster provider's descriptor folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除照片推荐的描述文件文件夹。"
          }
        }
      }
    },
    "Clears the gallery cache.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除图库缓存。"
          }
        }
      }
    },
    "Collections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合集"
          }
        }
      }
    },
    "Convert (may break the wallpaper)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换（可能损坏壁纸）"
          }
        }
      }
    },
    "Copy into LocalDevVPN: tunnel IP %@/%lld, peer %@, port %u.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Copy into LocalDevVPN: tunnel IP %1$@/%2$lld, peer %3$@, port %4$u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝到 LocalDevVPN：隧道 IP %1$@/%2$lld，对端 %3$@，端口 %4$u。"
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建"
          }
        }
      }
    },
    "Default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Discrete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Export": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
