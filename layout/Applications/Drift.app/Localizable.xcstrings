    "Flash Log (%lld lines)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷写日志（%lld 行）"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        }
      }
    },
    "Install as is": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原样安装"
          }
        }
      }
    },
    "Legacy Wallpaper Format": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版壁纸格式"
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源库"
          }
        }
      }
    },
    "Linear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线性"
          }
        }
      }
    },
    "Media": {
